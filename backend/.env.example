# Comma-separated frontend origins allowed by CORS ("*" allows any origin)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# true = fetch fresh data from Elexon at startup instead of using the committed snapshot in data/
REFRESH_ON_STARTUP=false
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
REQUEST_TIMEOUT_S=30
MAX_RETRIES=4
# Default decision cutoff (Europe/London wall-clock time on D-1)
DEFAULT_CUTOFF_HOUR=9
DEFAULT_CUTOFF_MINUTE=50
# MAPE ignores intervals whose actual is below this (guards against divide-by-zero)
MAPE_MIN_ACTUAL_MW=1
