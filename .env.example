# Root-level reference of every variable. Copy the relevant block into backend/.env or frontend/.env.

# ---- backend (FastAPI) ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
REFRESH_ON_STARTUP=false
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
REQUEST_TIMEOUT_S=30
MAX_RETRIES=4
DEFAULT_CUTOFF_HOUR=9
DEFAULT_CUTOFF_MINUTE=50
MAPE_MIN_ACTUAL_MW=1

# ---- frontend (Vite, baked in at build time) ----
# Full backend URL in production (e.g. https://wind-forecast-api.onrender.com); empty when served behind /api proxy.
VITE_API_URL=
